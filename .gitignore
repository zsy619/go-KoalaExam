backend/tmp/
koala-exam-backend/tmp/   # 旧目录名兼容

# Makefile 编译输出（bin/koala-exam）
backend/bin/
koala-exam-backend/bin/

# 测试覆盖率文件（来自 Makefile test-coverage 目标）
backend/coverage.out
backend/coverage.html
koala-exam-backend/coverage.out
koala-exam-backend/coverage.html

# air 构建错误日志
backend/build-errors.log
koala-exam-backend/build-errors.log

# 运行时日志（config.yaml: log.path = logs/koala.log）
backend/logs/
koala-exam-backend/logs/

# 用户上传文件（config.yaml: upload.path = uploads/）
uploads/
backend/uploads/
koala-exam-backend/uploads/

