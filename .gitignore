.idea/
*.iml
*.iws
*.ipr

# VS Code
.vscode/
*.code-workspace

# Vim / Emacs / 其他编辑器临时文件
*~
*.swp
*.swo
*.swn
.*.tmp
*$$
#*#
.#*

